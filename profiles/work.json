{
  "schema": 1,
  "id": "work",
  "name": "长工作",
  "description": "跨多轮的项目/工程工作：保留目标、进展、决策、阻塞与下一步，便于随时接续。",
  "title_field": "目标",
  "excerpt_field": "下一步",
  "fields": [
    { "key": "时间", "label": "时间", "weight": 1, "max_chars": 40, "hint": "YYYY-MM-DD" },
    { "key": "项目", "label": "项目 / 模块", "weight": 1, "max_chars": 120, "hint": "仓库、模块或任务线" },
    { "key": "目标", "label": "目标", "weight": 3, "required": true, "max_chars": 300, "hint": "本轮要推进的目标" },
    { "key": "进展", "label": "已完成 / 进展", "weight": 2, "max_chars": 500, "hint": "可验证的完成项" },
    { "key": "决策", "label": "关键决策", "weight": 2, "max_chars": 500, "hint": "选了什么、为什么" },
    { "key": "阻塞", "label": "阻塞 / 风险", "weight": 2, "max_chars": 400, "hint": "卡点、待确认、风险" },
    { "key": "文件", "label": "相关文件 / 命令", "weight": 1, "max_chars": 300, "hint": "路径、命令、链接" },
    { "key": "下一步", "label": "下一步", "weight": 3, "required": true, "max_chars": 400, "hint": "下一轮从哪继续" }
  ]
}
